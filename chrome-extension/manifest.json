{
  "manifest_version": 3,
  "name": "Instant Transmission – Goku Vanish for Video Calls",
  "version": "2.1.0",
  "description": "Put two fingers to your forehead on any video call to vanish with Goku's Instant Transmission effect! Works on Meet, Zoom, Teams, Discord, WhatsApp, OmeTV & more ⚡",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://discord.com/*",
    "https://web.whatsapp.com/*",
    "*://*.ome.tv/*",
    "https://ome.tv/*",
    "https://www.ome.tv/*",
    "*://*.minichat.com/*",
    "*://*.chatrandom.com/*",
    "*://*.coomeet.com/*",
    "https://meet.jit.si/*",
    "https://*.onjitsi.com/*",
    "https://app.slack.com/*",
    "https://www.messenger.com/*",
    "https://*.webex.com/*",
    "https://*.whereby.com/*",
    "https://*.around.co/*",
    "https://*.gather.town/*",
    "https://*.loom.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*",
        "https://web.whatsapp.com/*",
        "*://*.ome.tv/*",
        "https://ome.tv/*",
        "https://www.ome.tv/*",
        "*://*.minichat.com/*",
        "*://*.chatrandom.com/*",
        "*://*.coomeet.com/*",
        "https://meet.jit.si/*",
        "https://*.onjitsi.com/*",
        "https://app.slack.com/*",
        "https://www.messenger.com/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*",
        "https://*.around.co/*",
        "https://*.gather.town/*",
        "https://*.loom.com/*"
      ],
      "js": ["content/camera-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*",
        "https://web.whatsapp.com/*",
        "*://*.ome.tv/*",
        "https://ome.tv/*",
        "https://www.ome.tv/*",
        "*://*.minichat.com/*",
        "*://*.chatrandom.com/*",
        "*://*.coomeet.com/*",
        "https://meet.jit.si/*",
        "https://*.onjitsi.com/*",
        "https://app.slack.com/*",
        "https://www.messenger.com/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*",
        "https://*.around.co/*",
        "https://*.gather.town/*",
        "https://*.loom.com/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gesture/*",
        "assets/*",
        "libs/mediapipe/*",
        "libs/mediapipe/wasm/*",
        "models/*"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*",
        "https://web.whatsapp.com/*",
        "*://*.ome.tv/*",
        "https://ome.tv/*",
        "https://www.ome.tv/*",
        "*://*.minichat.com/*",
        "*://*.chatrandom.com/*",
        "*://*.coomeet.com/*",
        "https://meet.jit.si/*",
        "https://*.onjitsi.com/*",
        "https://app.slack.com/*",
        "https://www.messenger.com/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*",
        "https://*.around.co/*",
        "https://*.gather.town/*",
        "https://*.loom.com/*"
      ]
    }
  ]
}
